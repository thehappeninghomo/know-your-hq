# Copy this file to .env and fill in your keys

# Anthropic API key — required to generate fresh questions
ANTHROPIC_API_KEY=

# PostgreSQL — required for persistent leaderboard
# Local: postgresql://user:password@localhost:5432/dbname
# Render: copy the Internal Database URL from your Render Postgres service
DATABASE_URL=

# Server config
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# Required by destructive endpoints — generate with: openssl rand -hex 24
ADMIN_TOKEN=
