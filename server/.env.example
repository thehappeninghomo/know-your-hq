# Copy this file to .env and fill in your keys

# AI providers — at least one required
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# PostgreSQL — required for persistent leaderboard
# Local: postgresql://user:password@localhost:5432/dbname
# Render: copy the Internal Database URL from your Render Postgres service
DATABASE_URL=

# Server config
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
